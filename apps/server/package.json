{
  "name": "@remorse-chess/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build --workspace @remorse-chess/engine && tsc -p tsconfig.json",
    "typecheck": "npm run build --workspace @remorse-chess/engine && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@remorse-chess/engine": "*",
    "@remorse-chess/protocol": "*",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "socket.io-client": "^4.8.1"
  }
}
